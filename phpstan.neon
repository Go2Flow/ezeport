includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 3
    paths:
        - src
    ignoreErrors:
        # the users of a project live in the host application
        - message: '#App\\Models\\User not found#'
          path: src/Models/Project.php
    reportUnmatchedIgnoredErrors: false

services:
    -
        class: Go2Flow\Ezport\PHPStan\MagicCallMethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension